{
  "name": "personal-dev-kg-auth",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "tsx --test src/security-policy.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "auth:generate": "better-auth generate --config src/auth.ts --output auth-schema.sql --yes",
    "bootstrap-admin": "tsx src/bootstrap-admin.ts"
  },
  "dependencies": {
    "better-auth": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
